  <description>Standalone UR30 and Robotiq 3F hardware bring-up for the supermarket picking project.</description>
  <maintainer email="maintainer@example.com">Project Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>robotiq_3f_gripper_control</exec_depend>
